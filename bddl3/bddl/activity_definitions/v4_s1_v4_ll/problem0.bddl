(define (problem v4_s1_v4_ll-0)
    (:domain behavior-1k)

    ; COOHAVIOR S1-V4-LL, route S1-M5. The BDDL states the final state and the
    ; object scope; the ordered checkpoints are in route.json beside this file
    ; (coop2/ROUTE_SUPERVISION_PLAN.md). Every support a route node names must
    ; be declared here, or the cached instance cannot bind it -- and nothing
    ; raises when a goal names an object the scene does not have.
    ;
    ; One synset per line: the parser keeps only the last `- <synset>` group,
    ; so two lines for one synset silently lose the first.
    ;
    ; COOHAVIOR's own names, renumbered to our taxonomy: its bottom_cabinet.n.01
    ; is not a synset here (the category bottom_cabinet is cabinet.n.01), and
    ; its fridge.n.01 is our electric_refrigerator.n.01, and its shelf.n.01_3 is
    ; the model owvfik, which our dataset ships as a bookcase -- the same object,
    ; at the same pose (-0.17, 4.90) in kitchen_0, under a different category.
    (:objects
        die.n.01_1 - die.n.01
        floor.n.01_1 - floor.n.01
        cabinet.n.01_1 cabinet.n.01_2 cabinet.n.01_3 - cabinet.n.01
        bookcase.n.01_1 - bookcase.n.01
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        armchair.n.01_1 - armchair.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        coffee_table.n.01_1 - coffee_table.n.01
        bed.n.01_1 bed.n.01_2 - bed.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop die.n.01_1 floor.n.01_1)
        (inroom floor.n.01_1 childs_room)
        ; The route's supports, in route order. `inroom` is where the prompt
        ; gets each node's room from; route.json does not repeat it.
        (inroom cabinet.n.01_1 childs_room)
        (inroom bookcase.n.01_1 kitchen)
        (inroom electric_refrigerator.n.01_1 kitchen)
        (inroom armchair.n.01_1 dining_room)
        (inroom breakfast_table.n.01_1 dining_room)
        (inroom coffee_table.n.01_1 living_room)
        (inroom cabinet.n.01_2 living_room)
        (inroom cabinet.n.01_3 bedroom)
        (inroom bed.n.01_2 bedroom)
        (inroom bed.n.01_1 childs_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    ; The destination is station M5's bed, back in the room the die started in.
    ; COOHAVIOR's own S1-V4-LL.bddl says a bedroom floor; its route file and the
    ; prompt it hands the model say bed.n.01_1, and the route file is what it
    ; runs. The earlier version of this file was read off the stale BDDL.
    (:goal
        (and
            (ontop die.n.01_1 bed.n.01_1)
        )
    )
)
